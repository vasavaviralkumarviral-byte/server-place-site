# Copy this file to .env and fill it in only after you have a compatible host.
PORT=3000
ADMIN_TOKEN=replace-with-a-long-random-secret

# Pterodactyl-compatible panel settings. Keep the API key secret.
PTERODACTYL_URL=https://your-panel.example
PTERODACTYL_SERVER_ID=your-server-identifier
PTERODACTYL_API_KEY=ptlc_your_client_api_key

# Public addresses shown on the website
JAVA_ADDRESS=play.example.net
JAVA_PORT=25565
BEDROCK_ADDRESS=play.example.net
BEDROCK_PORT=19132
SERVER_NAME=Server Place SMP
